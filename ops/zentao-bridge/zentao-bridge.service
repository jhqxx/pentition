[Unit]
Description=ZenTao -> GitLab Issue bridge
Documentation=https://10.175.2.11:8082/lbxq/petition-desktop/-/blob/master/ops/zentao-bridge/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /srv/zentao-bridge/bridge.py
Restart=always
RestartSec=3
# 端口 / 目标 GitLab / 禅道容器等，默认值见 bridge.py 的 DEFAULTS，一般不用改
Environment=PORT=8099
Environment=GITLAB_URL=http://127.0.0.1:8082
Environment=GITLAB_PROJECT=1
Environment=ZENTAO_URL=http://10.175.2.11:8090

[Install]
WantedBy=multi-user.target
