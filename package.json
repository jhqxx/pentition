    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "element-plus": "^2.14.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "vue-tsc": "^3.3.14"
  }
