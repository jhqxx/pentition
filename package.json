{
  "name": "petition-desktop",
  "version": "0.2.9",
  "description": "Mall Desktop demo (Electron + Vue3 + Element Plus + SQLite)",
  "main": "./out/main/index.js",
  "author": "lbxq",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
